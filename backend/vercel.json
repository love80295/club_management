{
  "buildCommand": "python3 manage.py collectstatic --noinput",
  "installCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "functions": {
    "club_backend/wsgi.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/club_backend/wsgi.py"
    }
  ]
}
